{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poadomains.grok.me/agent-cart-v2.schema.json",
  "title": "PoA Domains Agent Cart Handoff v2 (unsigned plan, never a signed packet or spending approval)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "poa-domains.agent-cart.v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "livePoA": {
      "const": false
    },
    "unsigned": {
      "const": true
    },
    "context": {
      "enum": [
        "live-registry",
        "local-reference-only",
        "static-synthetic-demo"
      ]
    },
    "endpoint": {
      "type": "string",
      "format": "uri"
    },
    "chainId": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "genesisHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registryId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normalizationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observedServerTime": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signerPrincipal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "defaults": {
      "type": "object",
      "properties": {
        "bidBeneficiary": {
          "const": "signer"
        }
      },
      "required": [
        "bidBeneficiary"
      ],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "url": {
          "const": "https://poadomains.grok.me/mcp"
        },
        "transport": {
          "const": "Streamable HTTP"
        },
        "protocolVersion": {
          "const": "2025-11-25"
        },
        "identityMustMatch": {
          "const": true
        }
      },
      "required": [
        "url",
        "transport",
        "protocolVersion",
        "identityMustMatch"
      ],
      "additionalProperties": false
    },
    "cli": {
      "type": "object",
      "properties": {
        "prepare": {
          "type": "string"
        },
        "submit": {
          "type": "string"
        }
      },
      "required": [
        "prepare",
        "submit"
      ],
      "additionalProperties": false
    },
    "reads": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "receipt": {
          "type": "string"
        }
      },
      "required": [
        "capabilities",
        "state",
        "receipt"
      ],
      "additionalProperties": false
    },
    "writes": {
      "type": "object",
      "properties": {
        "intents": {
          "type": "object",
          "properties": {
            "method": {
              "const": "POST"
            },
            "path": {
              "type": "string"
            },
            "contentType": {
              "const": "application/json"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "method",
            "path",
            "contentType",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "intents"
      ],
      "additionalProperties": false
    },
    "spendingCapByAsset": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]{0,15}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,38})$"
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "initialState": {
          "const": "Verify exact identity, sequence and stateHash before the first operation. This is registry state, not native-chain finality."
        },
        "quote": {
          "const": "Quote and simulate each complete locally signed operation; compare versions/deed/generation and never exceed any cap."
        },
        "prepare": {
          "const": "Read get_nonce; use quote_domain's exact action params and build_metadata_witness for required metadata. Replace template markers locally, never submit them; sign only with explicit approval."
        },
        "changedVersion": {
          "const": "Abort on a changed version, ownership, price or offer; obtain a new explicit review, never silently repair the plan."
        },
        "budget": {
          "const": "Before signing, enforce every operation maxTotal and the whole-cart cap per asset; count committed and unknown operations against it."
        },
        "submit": {
          "const": "Submit only an explicitly approved complete signed packet. Keep its original bytes, requestId, nonce and intentId."
        },
        "receipt": {
          "const": "Poll get_receipt or GET /v1/receipts/{intentId}. No receipt means UNKNOWN, not rejection or permission for another payment."
        },
        "retry": {
          "const": "Resending the exact same packet is safe. After UNKNOWN, resend only identical signed bytes; never use a new requestId or nonce or regenerate the cart as a retry."
        }
      },
      "required": [
        "initialState",
        "quote",
        "prepare",
        "changedVersion",
        "budget",
        "submit",
        "receipt",
        "retry"
      ],
      "additionalProperties": false
    },
    "itemCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "action": {
            "enum": [
              "announceAuction+bid",
              "bid",
              "buyFixed",
              "fillChildOffer"
            ]
          },
          "asset": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,15}$"
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,38})$"
          },
          "maxTotal": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,38})$"
          },
          "maxNetworkFee": {
            "const": "0"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tier": {
            "enum": [
              "standard",
              "premium"
            ]
          },
          "isRoot": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "enum": [
                    "announceAuction",
                    "bid",
                    "buyFixed",
                    "fillChildOffer"
                  ]
                },
                "requestId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "maxTotal": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,38})$"
                },
                "maxNetworkFee": {
                  "const": "0"
                },
                "expectedVersion": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "auctionIdFrom": {
                  "anyOf": [
                    {
                      "const": "announcement receipt"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "action",
                "requestId",
                "maxTotal",
                "maxNetworkFee",
                "expectedVersion",
                "auctionIdFrom"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "index",
          "name",
          "action",
          "asset",
          "amount",
          "maxTotal",
          "maxNetworkFee",
          "requestId",
          "tier",
          "isRoot",
          "summary",
          "params",
          "operations",
          "steps"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "livePoA",
    "unsigned",
    "context",
    "endpoint",
    "chainId",
    "revision",
    "genesisHash",
    "registryId",
    "policyHash",
    "normalizationHash",
    "sequence",
    "stateHash",
    "generatedAt",
    "observedServerTime",
    "signerPrincipal",
    "defaults",
    "mcp",
    "cli",
    "reads",
    "writes",
    "spendingCapByAsset",
    "rules",
    "itemCount",
    "items"
  ],
  "additionalProperties": false
}
