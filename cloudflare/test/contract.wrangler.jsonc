{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"poa-contract-local-only",
  "main":"contract-worker.ts",
  "compatibility_date":"2026-11-08",
  "compatibility_flags":["nodejs_compat"],
  "assets":{"directory":"../../reference-web","binding":"ASSETS","run_worker_first":["/healthz","/v1/*","/d/*","/p/*"]},
  "alias":{"#poa-unicode-data":"../unicode-data.ts"},
  "rules":[{"type":"Text","globs":["**/*.txt"],"fallthrough":true}],
  "vars":{"PUBLIC_EXPLORER_URL":"https://poadomains.grok.me","BACKEND_HOST":"poadomains-registry.maxinfeld-artshow.workers.dev","CONTRACT_CONFIG":""}
}
