{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poadomains-registry",
  "account_id": "b1c96174cb665cac086ca06434ded1f2",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./reference-web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/healthz",
      "/v1/*",
      "/d/*",
      "/p/*",
      "/mcp",
      "/.well-known/*",
      "/llms.txt"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "PoaRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sqlite",
      "new_sqlite_classes": [
        "PoaRegistry"
      ]
    }
  ],
  "alias": {
    "#poa-unicode-data": "./cloudflare/unicode-data.ts"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "POA_ESCROW_ENABLED": "false",
    "POA_ESCROW_NETWORK_WRITES": "false",
    "POA_ESCROW_NEW_NAMES": "false",
    "POA_ESCROW_SUBNAMES": "false",
    "POA_ESCROW_PER_TX": "250000.000000",
    "POA_ESCROW_DAILY": "1000000.000000",
    "POA_ESCROW_ENGINE_SHA256": "746671f800a25ec365912e887bdb78251bae4be52453d6bd0ae505e7287f14ed",
    "POA_ESCROW_PARAMS_SHA256": "b6c2f50e33d07ac87897e18e7dc9c7737664f66044be83a7aa3cc92c83183c21",
    "PUBLIC_EXPLORER_URL": "https://poadomains.grok.me",
    "BACKEND_HOST": "poadomains-registry.maxinfeld-artshow.workers.dev",
    // Pinata group that holds profile media and profile JSON pins (public identifier, not a secret).
    "PINATA_GROUP_ID": "8c21bf28-7ce3-4282-a200-d9e7f50dcedc",
    // Public RSA-OAEP-4096 key (SPKI, base64). Backups encrypt role keys to it; the
    // matching private key is held offline by the operator, never in R2 or the Worker.
    "BACKUP_PUBLIC_KEY_SPKI": ""
  },
  "ratelimits": [
    { "name": "MCP_RATE_LIMITER", "namespace_id": "2026110908", "simple": { "limit": 60, "period": 60 } },
    { "name": "MEDIA_UPLOAD_LIMITER", "namespace_id": "2026112401", "simple": { "limit": 10, "period": 60 } }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "poadomains-registry-backups"
    },
    {
      "binding": "SEARCH_LOGS",
      "bucket_name": "poadomains-search-log"
    },
    {
      "binding": "PROFILES",
      "bucket_name": "poadomains-profiles"
    }
  ],
  "triggers": {
    "crons": [
      "47 8 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "build": {
    "command": "npm run cf:prepare"
  }
}
