{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poadomains-registry",
  "account_id": "b1c96174cb665cac086ca06434ded1f2",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./reference-web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/healthz",
      "/v1/*",
      "/d/*",
      "/p/*",
      "/mcp",
      "/.well-known/*",
      "/llms.txt"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "PoaRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sqlite",
      "new_sqlite_classes": [
        "PoaRegistry"
      ]
    }
  ],
  "alias": {
    "#poa-unicode-data": "./cloudflare/unicode-data.ts"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "POA_ESCROW_ENABLED": "false",
    "POA_ESCROW_NETWORK_WRITES": "false",
    "POA_ESCROW_PER_TX": "250000.000000",
    "POA_ESCROW_DAILY": "1000000.000000",
    "POA_ESCROW_ENGINE_SHA256": "4e1f5c41dda9fda8939d92ffd6e9c2f05b66b4b8f1c5ff271960ea18b7bc6aa5",
    "POA_ESCROW_PARAMS_SHA256": "82f994768b0bd7d430226147bfe90aad5aff1d4a50eae0400e8a950cb4416348",
    "PUBLIC_EXPLORER_URL": "https://poadomains.grok.me",
    "BACKEND_HOST": "poadomains-registry.maxinfeld-artshow.workers.dev",
    // Public RSA-OAEP-4096 key (SPKI, base64). Backups encrypt role keys to it; the
    // matching private key is held offline by the operator, never in R2 or the Worker.
    "BACKUP_PUBLIC_KEY_SPKI": ""
  },
  "ratelimits": [
    { "name": "MCP_RATE_LIMITER", "namespace_id": "2026110908", "simple": { "limit": 60, "period": 60 } }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "poadomains-registry-backups"
    }
  ],
  "triggers": {
    "crons": [
      "47 8 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "build": {
    "command": "npm run cf:prepare"
  }
}
