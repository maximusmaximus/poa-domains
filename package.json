{
  "name": "poa-domains-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline/local naming registry reference engine; not a live PoA integration",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "poa-domains": "dist/src/cli.js"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js test/ui-live-shaping.test.mjs test/ui-ownership.test.mjs && node --experimental-strip-types --test test/network-status-worker.test.mjs test/backup-codec.test.mjs",
    "test:coverage": "npm run ci:build && node scripts/ci.mjs coverage-local",
    "smoke": "npm run build && node dist/test/smoke.js",
    "unicode:audit": "node scripts/unicode-audit.mjs",
    "security": "node scripts/security-scan.mjs && npm audit --audit-level=high",
    "check": "npm run ci:build && node scripts/ci.mjs check",
    "pages:build": "npm run build && node dist/src/pages-build.js",
    "pages:smoke": "npm run pages:build && node dist/test/pages-smoke.js",
    "app": "npm run build && node dist/src/app.js",
    "app:cli": "node dist/src/reference-cli.js",
    "reference:demo": "npm run build && node dist/src/reference-demo.js",
    "reference:pages:smoke": "npm run build && node dist/test/reference-pages-smoke.js",
    "ui:e2e": "npm run pages:build && node dist/test/ui-ux-e2e-smoke.js",
    "start": "node dist/src/cli.js serve",
    "production:smoke": "npm run build && node dist/test/production-smoke.js",
    "native:smoke": "npm run build && node dist/test/native-live-smoke.js",
    "metadata:check": "node -e \"import('node:child_process').then(({execFileSync})=>execFileSync(process.platform==='win32'?'wsl':'python3',process.platform==='win32'?['--','env','PYTHONDONTWRITEBYTECODE=1','python3','-B','-m','unittest','discover','-s','tools/metadata-backup/tests','-v']:['-B','-m','unittest','discover','-s','tools/metadata-backup/tests','-v'],{stdio:'inherit',env:{...process.env,PYTHONDONTWRITEBYTECODE:'1'}}))\"",
    "test:live-network": "node --test test/live-network.test.mjs",
    "test:emoji-format": "node --test test/emoji-format-checker.test.mjs",
    "test:emoji-format:browser": "playwright test --config=test/playwright.emoji-format.config.mjs",
    "cf:prepare": "node scripts/cloudflare-prepare.mjs && node scripts/stamp-assets.mjs",
    "assets:stamp": "node scripts/stamp-assets.mjs",
    "cf:types": "wrangler types",
    "cf:typecheck": "npm run cf:prepare && npm run cf:types && tsc --project cloudflare/tsconfig.json --noEmit",
    "cf:dev": "npm run cf:prepare && wrangler dev --local --ip 127.0.0.1 --port 18879 --persist-to ./.local-cf-state",
    "cf:dry-run": "node scripts/worker-deploy.mjs --dry-run",
    "cf:test": "npm run build && node cloudflare/test/integration.mjs && node cloudflare/test/routes-contract.mjs",
    "cf:test:backup": "node --experimental-strip-types cloudflare/test/backup-restore.mjs",
    "backup:now": "node scripts/registry-backup.mjs",
    "backup:restore": "node --experimental-strip-types scripts/registry-restore.mjs",
    "escrow:ui": "npm run build && node cloudflare/test/escrow-ui.mjs",
    "escrow:test": "node scripts/test-escrow.mjs",
    "escrow:test:unit": "node scripts/test-escrow.mjs --unit",
    "ci:build": "npm run build && node dist/src/pages-build.js && npm run cf:typecheck && node scripts/ci-bundles.mjs",
    "ci:coverage": "node scripts/ci-coverage.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "typescript": "7.0.2",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  },
  "imports": {
    "#poa-unicode-data": {
      "types": "./src/unicode-data.ts",
      "default": "./dist/src/unicode-data.js"
    },
    "#poa-network-schema": {
      "types": "./web/network-schema.d.ts",
      "default": "./web/network-schema.js"
    }
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
